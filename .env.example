# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# DynamoDB
DYNAMODB_USERS_TABLE=minijira-users
DYNAMODB_TEAMS_TABLE=minijira-teams
DYNAMODB_PROJECTS_TABLE=minijira-projects
DYNAMODB_TASKS_TABLE=minijira-tasks
DYNAMODB_COMMENTS_TABLE=minijira-comments
DYNAMODB_ACTIVITY_LOG_TABLE=minijira-activity-log
DYNAMODB_TASKS_TEAM_INDEX=teamId-index
DYNAMODB_TASKS_ASSIGNEE_INDEX=assigneeId-index
DYNAMODB_PROJECTS_TEAM_INDEX=teamId-index

# S3
S3_BUCKET_ORIGINALS=minijira-images-originals
S3_BUCKET_RESIZED=minijira-images-resized
S3_REGION=us-east-1

# SNS & SQS
SNS_TOPIC_TASK_ASSIGNMENT=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:minijira-task-assignment
SNS_TOPIC_DAILY_DIGEST=arn:aws:sns:us-east-1:YOUR_ACCOUNT_ID:minijira-daily-digest
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/YOUR_ACCOUNT_ID/minijira-task-assignment

# Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id
COGNITO_DOMAIN=minijira-domain

# Backend
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
NODE_ENV=development

# Frontend
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_COGNITO_REGION=us-east-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_COGNITO_CLIENT_ID=your_client_id
REACT_APP_COGNITO_DOMAIN=minijira-domain
VITE_BACKEND_URL=http://localhost:5000
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=your_client_id
VITE_COGNITO_DOMAIN=minijira-domain

# CloudWatch
CLOUDWATCH_NAMESPACE=MiniJira
