# AWS Configuration
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# DynamoDB
DYNAMODB_USERS_TABLE=minijira-users
DYNAMODB_TEAMS_TABLE=minijira-teams
DYNAMODB_PROJECTS_TABLE=minijira-projects
DYNAMODB_TASKS_TABLE=minijira-tasks
DYNAMODB_COMMENTS_TABLE=minijira-comments
DYNAMODB_ACTIVITY_LOG_TABLE=minijira-activity-log

# S3
S3_ORIGINALS_BUCKET=minijira-images-originals
S3_RESIZED_BUCKET=minijira-images-resized
S3_REGION=eu-north-1

# SNS & SQS
SNS_TASK_ASSIGNMENT_TOPIC_ARN=arn:aws:sns:eu-north-1:YOUR_ACCOUNT_ID:minijira-task-assignment
SNS_DAILY_DIGEST_TOPIC_ARN=arn:aws:sns:eu-north-1:YOUR_ACCOUNT_ID:minijira-daily-digest
SQS_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/YOUR_ACCOUNT_ID/minijira-task-assignment

# Cognito
COGNITO_REGION=eu-north-1
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id
COGNITO_DOMAIN=minijira-domain

# Backend
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
NODE_ENV=development

# Frontend
REACT_APP_BACKEND_URL=http://localhost:5000
REACT_APP_COGNITO_REGION=eu-north-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_COGNITO_CLIENT_ID=your_client_id
REACT_APP_COGNITO_DOMAIN=minijira-domain

# CloudWatch
CLOUDWATCH_NAMESPACE=MiniJira
